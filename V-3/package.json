    "mysql2": "^3.23.4",
    "pino": "^9.9.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
