{
  "name": "whatsapp_bot_404_v3",
  "version": "3.0.0",
  "description": "Enterprise-grade, modular, local-first Baileys WhatsApp automation bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --max-old-space-size=512 dist/src/index.js",
